{
  "name": "vite-plugin-property-paths-to-types",
  "version": "1.2.0",
  "type": "commonjs",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.mjs",
  "author": "zongying_cao<zongying_cao@163.com>",
  "description": "Vite 插件：自动生成属性路径对应的类型定义",
  "repository": {
    "type": "git", 
    "url": "git@github.com:cao5zy/vite-plugin-property-paths-to-types.git"
  },
  "bugs": {
    "url": "https://github.com/cao5zy/vite-plugin-property-paths-to-types/issues"
  },
  "homepage": "https://github.com/cao5zy/vite-plugin-property-paths-to-types#readme",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/esm/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.ts", 
        "default": "./dist/cjs/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "package.json"
  ],
  "keywords": [
    "vite", "vite-plugin", "typescript", "type-generator"
  ],
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm",
    "build:cjs": "tsc --project tsconfig.cjs.json && mv dist/cjs/index.js dist/cjs/index.cjs",
    "build:esm": "tsc --project tsconfig.esm.json && mv dist/esm/index.js dist/esm/index.mjs",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^20.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "stylelint": "^15.0.0",
    "stylelint-config-standard": "^34.0.0",
    "stylelint-config-standard-scss": "^11.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.46.2",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "typescript": "^5.0.0"
  }
}
